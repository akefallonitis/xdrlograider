// SYNOPSIS:
//   Computes drift across the XspmGraph tier — field-level diff between current
//   and previous snapshots. Sources from Defender_<Category>_CL tables with
//   SourceName filter
//
//
// PARAMETERS:
//   lookback - ISO 8601 duration, default 24h. How far back to look for the "previous" snapshot.
//   window   - ISO 8601 duration, default 1h. Matches the XspmGraph-tier poll cadence.
//
// INVOCATION:
//   MDE_Drift_Exposure(24h, 1h) | where StreamName == 'MDE_<Stream>_CL'
//   MDE_Drift_Exposure()    // applies defaults
//
// NOTES:
//   - (2026-05-04): rewritten to source from Defender_<Category>_CL
//     tables with SourceName filter. Drift logic preserved from v0.1.0 GA.
//   - Drift is computed over the per-stream typed columns (DCR-projected at
//     ingest); RawJson is preserved as a fallback. The parser never re-parses RawJson.
//   - Output schema: TimeGenerated, StreamName, EntityId, FieldName, OldValue,
//     NewValue, SnapshotCurrent, SnapshotPrevious, ChangeType.

let MDE_Drift_Exposure = (lookback:timespan = 24h, window:timespan = 1h) {
    // Metadata + envelope columns excluded from field-level diff.
    let metaCols = dynamic(['TimeGenerated', 'SourceStream', 'SourceName', 'EntityId', 'RawJson', 'Type', 'TenantId']);
    let sources = union (Defender_ConfigurationAndSettings_CL | where SourceName in ('MDE_AssetClassificationSchema_CL')), (Defender_ExposureManagement_CL | where SourceName in ('MDE_AssetRules_CL', 'MDE_XspmInitiatives_CL', 'MDE_ExposureSnapshots_CL', 'MDE_ExposureRecommendations_CL', 'MDE_XspmAttackPaths_CL', 'MDE_XspmChokePoints_CL', 'MDE_XspmTopTargets_CL', 'MDE_PostureInitiativesSummarized_CL', 'MDE_PostureMetrics_CL', 'MDE_AppsSecureScore_CL', 'MDE_DataSecureScore_CL', 'MDE_IdentitySecureScore_CL', 'MDE_PostureSecurityEvents_CL', 'MDE_PostureTenants_CL', 'MDE_AttackSurfaceAttackPaths_CL', 'MDE_AttackSurfaceChokepoints_CL', 'MDE_XspmConnectors_CL'))
        | where TimeGenerated > ago(lookback);
    let current = sources
        | where TimeGenerated > ago(window)
        | summarize arg_max(TimeGenerated, *) by SourceName, EntityId
        | extend TypedBag = bag_remove_keys(pack_all(), metaCols);
    let previous = sources
        | where TimeGenerated between (ago(lookback) .. ago(window))
        | summarize arg_max(TimeGenerated, *) by SourceName, EntityId
        | extend TypedBag = bag_remove_keys(pack_all(), metaCols);
    current
    | join kind=leftouter previous on SourceName, EntityId
    | where hash(tostring(TypedBag)) != hash(tostring(TypedBag1)) or isnull(TypedBag1)
    | extend CurrentFields  = bag_keys(TypedBag)
    | extend PreviousFields = iff(isnull(TypedBag1), dynamic([]), bag_keys(TypedBag1))
    // Section R++.C B4 fix (2026-05-07): correct Added/Removed/Modified classification.
    | mv-apply field = set_union(CurrentFields, PreviousFields) to typeof(string) on (
        extend
            FieldInCurrent  = set_has_element(CurrentFields,  tostring(field)),
            FieldInPrevious = set_has_element(PreviousFields, tostring(field))
        | extend
            NewValue = iff(FieldInCurrent,  tostring(TypedBag[tostring(field)]),  ''),
            OldValue = iff(FieldInPrevious, tostring(TypedBag1[tostring(field)]), '')
        | where NewValue != OldValue or (FieldInCurrent != FieldInPrevious)
      )
    | project
        TimeGenerated,
        StreamName       = SourceName,
        EntityId,
        FieldName        = tostring(field),
        OldValue,
        NewValue,
        SnapshotCurrent  = TimeGenerated,
        SnapshotPrevious = TimeGenerated1,
        ChangeType       = case(
            not(FieldInPrevious), "Added",
            not(FieldInCurrent),  "Removed",
            "Modified"
        )
};
MDE_Drift_Exposure