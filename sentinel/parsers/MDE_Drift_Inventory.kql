// SYNOPSIS:
//   Computes drift across the Inventory tier — field-level diff between current
//   and previous snapshots. Sources from Defender_<Category>_CL tables with
//   SourceName filter
//
//
// PARAMETERS:
//   lookback - ISO 8601 duration, default 14d. How far back to look for the "previous" snapshot.
//   window   - ISO 8601 duration, default 1d. Matches the Inventory-tier poll cadence.
//
// INVOCATION:
//   MDE_Drift_Inventory(14d, 1d) | where StreamName == 'MDE_<Stream>_CL'
//   MDE_Drift_Inventory()    // applies defaults
//
// NOTES:
//   - (2026-05-04): rewritten to source from Defender_<Category>_CL
//     tables with SourceName filter. Drift logic preserved from v0.1.0 GA.
//   - Drift is computed over the per-stream typed columns (DCR-projected at
//     ingest); RawJson is preserved as a fallback. The parser never re-parses RawJson.
//   - Output schema: TimeGenerated, StreamName, EntityId, FieldName, OldValue,
//     NewValue, SnapshotCurrent, SnapshotPrevious, ChangeType.

let MDE_Drift_Inventory = (lookback:timespan = 14d, window:timespan = 1d) {
    // Metadata + envelope columns excluded from field-level diff.
    let metaCols = dynamic(['TimeGenerated', 'SourceStream', 'SourceName', 'EntityId', 'RawJson', 'Type', 'TenantId']);
    let sources = union (Defender_EndpointConfiguration_CL | where SourceName in ('MDE_AdvancedFeatures_CL', 'MDE_DeviceControlPolicy_CL', 'MDE_WebContentFiltering_CL', 'MDE_SmartScreenConfig_CL', 'MDE_LiveResponseConfig_CL', 'MDE_AuthenticatedTelemetry_CL', 'MDE_PUAConfig_CL', 'MDE_AntivirusPolicy_CL', 'MDE_CustomCollection_CL')), (Defender_EndpointDeviceManagement_CL | where SourceName in ('MDE_LicenseReport_CL', 'MDE_DeviceTimeline_CL')), (Defender_IdentityProtection_CL | where SourceName in ('MDE_SAClassification_CL', 'MDE_IdentityOnboarding_CL', 'MDE_IdentityServiceAccounts_CL', 'MDE_DCCoverage_CL', 'MDE_IdentityAlertThresholds_CL', 'MDE_RemediationAccounts_CL')), (Defender_MultiTenantOperations_CL | where SourceName in ('MDE_TenantContext_CL', 'MDE_TenantWorkloadStatus_CL', 'MDE_MtoTenants_CL')), (Defender_VulnerabilityManagement_CL | where SourceName in ('MDE_SecurityBaselines_CL'))
        | where TimeGenerated > ago(lookback);
    let current = sources
        | where TimeGenerated > ago(window)
        | summarize arg_max(TimeGenerated, *) by SourceName, EntityId
        | extend TypedBag = bag_remove_keys(pack_all(), metaCols);
    let previous = sources
        | where TimeGenerated between (ago(lookback) .. ago(window))
        | summarize arg_max(TimeGenerated, *) by SourceName, EntityId
        | extend TypedBag = bag_remove_keys(pack_all(), metaCols);
    current
    | join kind=leftouter previous on SourceName, EntityId
    | where hash(tostring(TypedBag)) != hash(tostring(TypedBag1)) or isnull(TypedBag1)
    | extend CurrentFields  = bag_keys(TypedBag)
    | extend PreviousFields = iff(isnull(TypedBag1), dynamic([]), bag_keys(TypedBag1))
    | mv-apply field = set_union(CurrentFields, PreviousFields) to typeof(string) on (
        extend
            NewValue = tostring(TypedBag[tostring(field)]),
            OldValue = tostring(iff(isnull(TypedBag1), '', TypedBag1[tostring(field)]))
        | where NewValue != OldValue
      )
    | project
        TimeGenerated,
        StreamName       = SourceName,
        EntityId,
        FieldName        = tostring(field),
        OldValue,
        NewValue,
        SnapshotCurrent  = TimeGenerated,
        SnapshotPrevious = TimeGenerated1,
        ChangeType       = iff(isnull(TypedBag1), "Added", iff(isnull(TypedBag[tostring(field)]), "Removed", "Modified"))
};
MDE_Drift_Inventory