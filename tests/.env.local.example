# Copy to tests/.env.local (gitignored). Fill in values for YOUR operator tenant.
# NEVER commit. Validator: tests/Assert-EnvLocal.ps1 runs at start of T2/T3.

# ---- Tier 2 (SP for ARM ops; SP login locally; OIDC fed-cred in CI) ----
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=replace-with-secret-or-blank-if-using-azure-cli-login
XDRLR_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
XDRLR_TEST_RG=rg-xdrlr-test
XDRLR_TEST_WORKSPACE_RESOURCE_ID=/subscriptions/SUB/resourceGroups/RG/providers/Microsoft.OperationalInsights/workspaces/WS

# ---- Tier 3 (SA for live portal probe; one TOTP burn ~= one batch capture) ----
XDRLR_TEST_UPN=xdrlogreader@yourtenant.onmicrosoft.com
XDRLR_TEST_PASSWORD=replace-with-sa-password
XDRLR_TEST_TOTP_SECRET=BASE32SECRETFROMAUTHENTICATORAPP

# ---- Optional probe pacing ----
XDRLR_PROBE_RATE_MS=500
XDRLR_PROBE_MAX_PARALLEL=1
