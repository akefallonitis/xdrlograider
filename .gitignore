# Phase 0 capture data — NEVER commit these. They contain operator runtime
# evidence (HTTP responses with real tenant IDs, UPNs, IPs, OAuth tokens,
# JWTs, machineIds, etc.). Re-captured locally on demand; never public.
references/**/live.json
references/**/_AUTH_RESEARCH.json
references/**/_PORTAL.json

# Non-Defender portal captures are v0.2.0+ research data — re-capture under
# proper PII scrub when those portals land. v0.1.0 only ships Defender.
references/entra-*/
references/exchange/
references/intune-*/
references/m365-*/
references/purview/
references/purview-portal/
references/security-copilot/
references/sharepoint/
references/teams/
references/viva/
references/power-platform/

