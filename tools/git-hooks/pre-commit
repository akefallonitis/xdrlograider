#!/bin/sh
# pre-commit hook — runs tools/Pre-Commit-Check.ps1 before EVERY commit.
#
# Section R BINDING methodology (2026-05-06): no commit lands on the
# repo without the full local gate (pyramid + WiringAudit + ARM-validate
# + Manifest-validate + DCR-schema + PSScriptAnalyzer). Skipping is NOT
# a path; if you genuinely need to bypass for a clean rebase or similar,
# use `git commit --no-verify` and accept that you've broken the methodology.
#
# Hook chains the SAME local gates that ci.yml runs, so dev-vs-CI parity is
# guaranteed.

set -e

# Locate Pre-Commit-Check.ps1 relative to repo root (the hook runs with
# CWD = repo root in standard git workflows).
SCRIPT="./tools/Pre-Commit-Check.ps1"

if [ ! -f "$SCRIPT" ]; then
    echo "[pre-commit] WARNING: $SCRIPT not found — skipping local gates."
    echo "[pre-commit] If this is a fresh clone, run: ./tools/Install-GitHooks.ps1"
    exit 0
fi

# pwsh required (PowerShell 7.x).
if ! command -v pwsh >/dev/null 2>&1; then
    echo "[pre-commit] ERROR: PowerShell 7 (pwsh) is required to run Pre-Commit-Check.ps1"
    echo "[pre-commit] Install: https://github.com/PowerShell/PowerShell/releases"
    exit 1
fi

echo "[pre-commit] Running tools/Pre-Commit-Check.ps1 — full local gate chain..."
echo "[pre-commit] (To bypass for emergency: git commit --no-verify; accept the methodology break)"

pwsh -NoProfile -File "$SCRIPT"
exit_code=$?

if [ $exit_code -ne 0 ]; then
    echo ""
    echo "[pre-commit] ❌ FAIL — Pre-Commit-Check.ps1 exited $exit_code"
    echo "[pre-commit] Section R.6 BINDING: do not push without all local gates green."
    exit $exit_code
fi

echo "[pre-commit] ✅ all local gates green — commit proceeding"
exit 0
